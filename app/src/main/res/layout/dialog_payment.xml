<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Amount (KES)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:hint="Method (M-Pesa / Bank / Cash)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMethod" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:hint="Reference (e.g. M-Pesa code)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReference" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
